# Строка подключения к Supabase Postgres (пул-коннектор, порт 5432/6543)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Куда mcp_server.py шлёт запросы (внутри compose — имя сервиса search)
SEARCH_URL=http://search:8000

# Мультиязычная модель эмбеддингов, размерность должна совпадать со schema.sql
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Порт, на котором слушает mcp_server.py
MCP_PORT=8001
